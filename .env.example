# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del backend (tfm-hcc) para DESARROLLO LOCAL.
#
#     cp .env.example .env
#
# Los valores de abajo son fijos y funcionan tal cual contra la base de datos
# desechable de `compose.yaml` y la siembra de `scripts/inserts.sql`. NO son
# secretos reales: en producción se inyectan por variables de entorno del
# sistema (que tienen prioridad sobre este fichero).
#
# - `docker compose` lee `.env` para crear el rol de PostgreSQL.
# - El backend lo carga solo al arrancar (`springboot3-dotenv`); no hay que
#   exportar nada a mano.
#
# `.env` está en .gitignore y no se sube; este `.env.example` sí.
# ─────────────────────────────────────────────────────────────────────────────

# --- PostgreSQL (datos clínicos y de negocio) ---
DB_USERNAME=hcc
DB_PASSWORD=hcc
# Cifrado TLS de la conexión con PostgreSQL (ver CONFIGURACION-SSL-TLS-POSTGRESQL.md).
#   prefer      -> TLS si está disponible, si no texto plano (valor por defecto).
#   require     -> exige TLS, sin validar el certificado del servidor.
#   verify-full -> exige TLS y valida cadena + hostname (requiere DB_SSLROOTCERT).
# Para usarlo en local hay que generar antes los certificados y recrear el
# contenedor con `docker compose up -d` (usa compose.override.yaml).
DB_SSLMODE=prefer
# Ruta al certificado de la CA (solo para verify-ca / verify-full):
# DB_SSLROOTCERT=certs/postgres/ca.crt

# --- MongoDB (registros de acceso y auditoría) ---
MONGODB_URI=mongodb://localhost:27017/hcc_logs

# --- Seguridad (valores de desarrollo; en producción, secretos reales por entorno) ---
# Secreto de firma de los JWT: Base64 que decodifica a 32 bytes.
JWT_SECRET=SENDLWRldiBKV1Qgc2lnbmluZyBrZXkgLSBub3QgYSA=

# Clave AES para cifrar campos personales (NIF, teléfono, fecha de nacimiento...)
# y archivos clínicos: Base64 que decodifica a 32 bytes (AES-256).
# Tiene que coincidir con la clave con la que se generó scripts/inserts.sql
# (mismo valor por defecto en scripts/generar_datos_usuarios.py).
TFM_HCC_ENCRYPTION_KEY=SENDLWRldiBBRVMga2V5IC0gbm90IGEgcmVhbCBzZWM=

# --- CORS y frontend (opcionales: los valores por defecto valen en local) ---
# CORS_ALLOWED_ORIGINS=http://localhost:8080,https://localhost:8080
# FRONTEND_BASE_URL=http://localhost:8080

# --- Login con Google ---
# Sin estas dos variables, el login con Google queda desactivado sin más (no hace falta
# ningún profile de Spring): /oauth2/authorization/google simplemente no tiene ningún
# filtro que lo atienda.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Correo transaccional (restablecimiento de contraseña) ---
# En local no hace falta un SMTP real: con MAIL_ENABLED=false (por defecto) el
# enlace de restablecimiento se escribe en el log en vez de enviarse. Para
# probar el envío real, levanta un SMTP de captura (p. ej. MailHog/Mailpit en
# el puerto 1025) y pon MAIL_ENABLED=true.
# MAIL_ENABLED=false
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# MAIL_FROM=no-reply@historiaclinicacomun.local
# Vida del enlace de restablecimiento, en minutos (por defecto 30).
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30
